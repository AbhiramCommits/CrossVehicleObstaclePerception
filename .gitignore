.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store

# Large artefacts are regenerated by `make all`
results/*.pt
results/*.onnx
results/smoke_*.json
datasets/.work/
datasets/*/images/
datasets/*/labels/
datasets_fixture/
*.log

# Keep the reproducibility manifest + checksums, ignore the pixel payloads
!datasets/MANIFEST.json
!datasets/checksums.sha256
